DATA_SOURCE_NAME="host=localhost user=postgres password=postgres dbname=custapi port=5432 sslmode=disable"
PORT=8080
CORS_ORIGINS="http://localhost:3000"

# --- OpenTelemetry ---
# Traces go to AWS X-Ray and metrics go to CloudWatch via an ADOT
# (AWS Distro for OpenTelemetry) Collector sidecar. See docs/observability.md.
#
# Set OTEL_ENABLED=false for local development without a collector running
# (e.g. `go run cmd/main.go` with nothing listening on 4317) to avoid
# exporter connection errors in the logs; instrumentation becomes a no-op.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=custapi
OTEL_SERVICE_VERSION=dev
# One of: development, qa, staging, production
DEPLOYMENT_ENVIRONMENT=development
# The ADOT collector sidecar is always reachable on localhost within an ECS
# task (sidecars share the task's network namespace).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Fraction of root spans sampled (0.0-1.0).
OTEL_TRACES_SAMPLER_RATIO=1.0
# How often metrics are pushed to the collector, in milliseconds.
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
